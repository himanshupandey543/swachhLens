# SwachLens Backend Configuration
# Copy this to .env and fill in your values

# Database (Railway will auto-populate DATABASE_URL)
# For local development, leave commented to use SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me-in-production

# JWT Configuration
JWT_SECRET=supersecretkey123456789
JWT_EXPIRES_HOURS=168

# CORS - Add your frontend URLs (comma-separated)
FRONTEND_ORIGINS=http://localhost:8000,http://localhost:8090,https://your-app.netlify.app

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=0

# AI Model (optional)
# AI_MODEL_PATH=ai/models/best.pt
AI_MAX_PHOTO_BYTES=2621440
